# ==========================================
# ReelDrop Configuration
# ==========================================

# 1. Meta / Instagram App Credentials (From Meta for Developers: https://developers.facebook.com/)
INSTAGRAM_APP_ID=your_meta_app_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here

# 2. Optional Long-Lived System or Creator Access Token
# If you want server-wide authorized resolution for verified creator assets:
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_ACCESS_TOKEN=

# 3. Rate Limiting Configuration
# Maximum requests permitted per client IP within sliding window:
RATE_LIMIT_MAX_REQUESTS=20
# Sliding window in milliseconds (default: 60,000ms = 1 minute):
RATE_LIMIT_WINDOW_MS=60000

# 4. Developer / Test Fixtures Toggle
# Set to 'true' during local development to preview full download streaming flows without active Meta keys:
ENABLE_MOCK_FIXTURES=true

# 5. Environment
NODE_ENV=development
